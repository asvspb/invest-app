{
  "name": "invest-app",
  "version": "1.0.0",
  "description": "Это простое веб-приложение, которое включает в себя два калькулятора: банковский калькулятор и ретейл калькулятор. Приложение позволяет пользователям рассчитывать прибыль от инвестиций в различных сценариях.",
  "homepage": "https://github.com/asvspb/invest-app#readme",
  "bugs": {
    "url": "https://github.com/asvspb/invest-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asvspb/invest-app.git"
  },
  "license": "ISC",
  "author": "asv",
  "type": "commonjs",
  "main": "dist/server/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -n vite,server -c green,cyan \"vite\" \"tsx watch server/server.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
